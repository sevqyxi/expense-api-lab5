# Скопіюйте цей файл у .env і за потреби змініть значення
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# порти PostgreSQL на комп'ютері: кожен сервіс має власну БД
USER_DB_PORT=5433
EXPENSE_DB_PORT=5434

# секрет для підпису JWT (використовує тільки User Service).
# для реального середовища згенеруйте свій:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-local-dev-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60

# адреса gRPC User Service для Expense Service (для локального запуску без Docker)
USER_SERVICE_GRPC_ADDR=localhost:50051
